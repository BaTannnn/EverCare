                "prescriptions",
                "{{prescriptionId}}"
              ]
            }
          }
        },
        {
          "name": "Dispense prescription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pharmacist/prescriptions/{{prescriptionId}}/dispense",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pharmacist",
