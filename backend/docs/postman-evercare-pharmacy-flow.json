    },
    {
      "name": "05 - Prescriptions dispensing",
      "item": [
        {
          "name": "Get prescribed prescriptions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lay danh sach don cho cap phat thanh cong', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (Array.isArray(json) && json.length > 0) {",
                  "    pm.collectionVariables.set('prescriptionId', json[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pharmacist/prescriptions?status=PRESCRIBED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pharmacist",
                "prescriptions"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PRESCRIBED"
                }
              ]
            }
          }
        },
        {
          "name": "Get prescription detail",
          "request": {
            "method": "GET",
            "header": [
