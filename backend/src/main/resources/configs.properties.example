department.pageSize = 8
medicalService.pageSize = 8
doctor.pageSize = 8
doctorSchedule.pageSize = 8
patientRecord.pageSize = 8
appointment.pageSize = 8
pharmacistPrescription.pageSize = 10
pharmacistMedicine.pageSize = 10
pharmacistMedicineBatch.pageSize = 10
staffTestRequest.pageSize = 10
staffTestResult.pageSize = 10

# Configure these as environment variables; never commit real secrets.
mimo.chat-completions-url = ${MIMO_CHAT_COMPLETIONS_URL:https://api.openai.com/v1/chat/completions}
mimo.model = ${MIMO_MODEL:gpt-4o-mini}
mimo.api.key = ${MIMO_API_KEY:}

jwt.secret = ${JWT_SECRET:}
jwt.expiration-ms = ${JWT_EXPIRATION_MS:86400000}

mail.host=${MAIL_HOST:smtp.gmail.com}
mail.port=${MAIL_PORT:587}
mail.username=${MAIL_USERNAME:}
mail.password=${MAIL_PASSWORD:}
mail.from=${MAIL_FROM:${MAIL_USERNAME:}}
mail.transport.protocol=smtp
mail.smtp.auth=true
mail.smtp.starttls.enable=true
mail.smtp.connectiontimeout=5000
mail.smtp.timeout=5000
mail.smtp.writetimeout=5000

# CORS
cors.frontend.url = ${FRONTEND_BASE_URL:http://localhost:5173}
